{
  "name": "ai-job-application-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "verify:ollama": "node --experimental-strip-types scripts/verify-ollama.ts",
    "verify": "node --experimental-strip-types scripts/verify-ollama.ts",
    "evaluate:ollama": "node --experimental-strip-types scripts/evaluate-ollama.ts",
    "evaluate:quality": "node --experimental-strip-types scripts/evaluate-quality-correction.ts",
    "ollama:serve": "node scripts/serve-ollama.mjs",
    "acceptance:ollama": "node --experimental-strip-types scripts/acceptance-ollama.ts",
    "demo:seed": "node --experimental-strip-types scripts/demo.ts",
    "demo": "node --experimental-strip-types scripts/portfolio-demo.ts",
    "demo:capture": "node --experimental-strip-types scripts/portfolio-demo.ts --capture",
    "format": "prettier --write app lib fixtures scripts tests e2e *.ts *.json .github/workflows/ci.yml README.md"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vitest": "5.1.0"
  }
}
